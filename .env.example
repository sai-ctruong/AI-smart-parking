# Copy to .env at the repository root for local development.
# Fill in POSTGRES_USER and POSTGRES_PASSWORD, then set DATABASE_URL using
# the same values. URL-encode reserved characters in the URL password.
POSTGRES_DB=smart_parking
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DATABASE_URL=
CORS_ORIGINS=["http://localhost:5173"]
VITE_API_BASE_URL=http://localhost:8000

# Generate a unique secret of at least 32 random bytes; never commit the value.
AUTH_SECRET_KEY=
ACCESS_TOKEN_MINUTES=15

# Private original snapshots. Development defaults to backend/data/snapshots.
# Production requires an explicit absolute IMAGE_STORAGE_ROOT outside the web root.
# IMAGE_STORAGE_ROOT=C:\private\smart-parking\snapshots
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=20000000
STALE_AFTER_SECONDS=300

# Optional AI inference configuration; point to a trained checkpoint you own.
PARKING_MODEL_CHECKPOINT=
PARKING_CONFIDENCE_THRESHOLD=0.7
PARKING_INFERENCE_BATCH_SIZE=32
PARKING_INFERENCE_DEVICE=auto
