# Copy to .env at the repository root for local development.
# Fill in POSTGRES_USER and POSTGRES_PASSWORD, then set DATABASE_URL using
# the same values. URL-encode reserved characters in the URL password.
POSTGRES_DB=smart_parking
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DATABASE_URL=
CORS_ORIGINS=["http://localhost:5173"]
VITE_API_BASE_URL=http://localhost:8000

# Optional AI inference configuration; point to a trained checkpoint you own.
PARKING_MODEL_CHECKPOINT=
PARKING_CONFIDENCE_THRESHOLD=0.7
PARKING_INFERENCE_BATCH_SIZE=32
PARKING_INFERENCE_DEVICE=auto
